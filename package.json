    "url": "https://github.com/fzh000543/deepseek-search-console/issues"
  },
  "keywords": [
    "deepseek",
    "search",
    "chat",
    "rag",
    "nodejs",
    "windows",
    "local-first"
  ],
  "devDependencies": {
    "esbuild": "^0.25.12",
    "postject": "^1.0.0-alpha.6"
  }
